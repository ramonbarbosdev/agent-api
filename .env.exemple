# =============================================================================
# Agent API — copie para .env na raiz: cp .env.exemple .env
# =============================================================================
#
# Servidor (admin): Postgres, JWT, sidecar, pasta do Cursor.
# Por usuário (no app): API key Cursor, agentes, chat.
#
# =============================================================================

SERVER_PORT=8080

# --- PostgreSQL ---
DATABASE_URL=jdbc:postgresql://localhost:5432/db_agent
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# --- Auth ---
AGENT_AUTH_ENABLED=true
AGENT_AUTH_JWT_SECRET=altere-isso-use-um-segredo-longo-aleatorio-32chars
AGENT_AUTH_JWT_EXPIRATION_MINUTES=1440

# Cifra API keys no banco (Base64 de 32 bytes). Dev: vazio = chave temporária.
AGENT_API_SECRETS_KEY=

# --- Cursor (servidor) ---
# Pasta no disco onde o agente Cursor trabalha (obrigatório para chat).
AGENT_GATEWAY_DEFAULT_PROJECT_PATH=C:/Users/Ramon/Documents/dev/Java/agent-api

CURSOR_SIDECAR_URL=http://127.0.0.1:8791
CURSOR_SIDECAR_TOKEN=defina-um-token-forte-compartilhado-com-o-sidecar
CURSOR_SIDECAR_AUTO_START=false

AGENT_API_IA_PATH=/home/ia
AGENT_API_AUDIT_PATH=
AGENT_API_MAX_SESSIONS=10
AGENT_API_SESSION_TIMEOUT=120
AGENT_API_MAX_MESSAGE_CHARS=32000

# Opcional: só paths dentro destas raízes (vírgula, sem espaços)
AGENT_API_PROJECT_ROOT_ALLOWLIST=

# --- Conversas / RAG (opcional) ---
AGENT_TENANT_MODE=single
CONVERSATION_HISTORY_LIMIT=50
AGENT_RAG_ENABLED=true
AGENT_RAG_TOP_K=4
AGENT_RAG_CHUNK_MAX_CHARS=900
AGENT_RAG_CHUNK_OVERLAP=120

# Sidecar Node: CURSOR_SIDECAR_PORT=8791, CURSOR_SIDECAR_HOST=127.0.0.1
# API key Cursor: cada usuário em /api/connections/cursor (não vai aqui).
