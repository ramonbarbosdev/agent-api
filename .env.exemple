# PostgreSQL (docker compose up -d)
DATABASE_URL=jdbc:postgresql://localhost:5432/db_agent
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Uma organizacao por instalacao (single-tenant). Padrao: single
AGENT_TENANT_MODE=single
AGENT_MAX_TOOL_STEPS=5
AGENT_MAX_CONTEXT_CHARS=48000

AGENT_RAG_ENABLED=true
AGENT_RAG_TOP_K=4

# Ollama na mesma máquina: http://localhost:11434
# Ollama em outro PC/rede: http://192.168.x.x:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=60s
